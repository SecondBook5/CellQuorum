# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Python build artifacts
build/
dist/
*.egg-info/
.eggs/

# mkdocs build output (the rendered site; docs/ is the source, site/ is generated)
site/

# Test, lint, and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# R writes this to the CWD when a plotting call runs without an explicit device.
# RscriptBackend now runs every R script from a throwaway directory, so nothing
# CellQuorum invokes produces it any more; kept only for hand-run R in a checkout.
Rplots.pdf

# Notebook noise
.ipynb_checkpoints/

# OS and editor noise
.DS_Store
.vscode/
.idea/

# CellQuorum run outputs
runs/
outputs/
results/
figures/
reports/
logs/
objects/
provenance/

# Un-ignore the report-rendering source package (the output-dir patterns above,
# e.g. reports/, must not swallow src/cellquorum/reports/).
!src/cellquorum/reports/
!src/cellquorum/reports/**
# ...but the un-ignore above must not resurrect bytecode under that package.
src/cellquorum/reports/**/__pycache__/

# Snakemake state and Docker build logs
.snakemake/
docker_build_*.log

# Large single-cell data objects
*.h5ad
*.h5
*.loom
*.mtx
*.rds
*.rda
*.qs

# Downloaded external reference databases (NicheNet networks, SCENIC/cisTarget
# rankings + motif tables, etc.) — populated locally per install, never tracked.
# Some payloads (*.feather, *.tbl, *.txt, *.pre_soupx) fall outside the data-object
# patterns above, so ignore the whole directory to keep 800MB+ out of the repo.
resources/

# Local environment files
.env
.envrc

docs/superpowers/
.superpowers/

# Claude Code worktrees
.claude/worktrees/
.worktrees/
.claude/

# Study-specific run scripts and configs (le_global lymphedema project)
scripts/le_*.py
configs/le_global_granular.yaml

# The `clean` variants pin absolute run directories and a /mnt cellranger root, so they
# describe one machine rather than the engine. Kept out of the tree for the same reason
# as the granular config above; `configs/le_global.yaml` remains the portable example.
configs/le_global_clean.yaml
configs/le_global_clean_da.yaml
configs/le_global_clean_da_artifact_kept.yaml
configs/le_global_clean_da_paired.yaml

# Lymphedema-specific validation: proves the engine on one real dataset, but the
# study scripts and their outputs are not part of the reusable engine.
lymphedema/

# Test/tutorial datasets. The DATA is never tracked — GSE140819 alone is 1.2 GB — but the
# recipe is: scripts/prepare_gse140819.py plus configs/gse140819.yaml reproduce this directory
# from GEO. A reusable package ships the downloader, not the bytes.
data/
