# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Python build artifacts
build/
dist/
*.egg-info/
.eggs/

# Test, lint, and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebook noise
.ipynb_checkpoints/

# OS and editor noise
.DS_Store
.vscode/
.idea/

# CellQuorum run outputs
runs/
outputs/
results/
figures/
reports/
logs/
objects/
provenance/

# Un-ignore the report-rendering source package (the output-dir patterns above,
# e.g. reports/, must not swallow src/cellquorum/reports/).
!src/cellquorum/reports/
!src/cellquorum/reports/**
# ...but the un-ignore above must not resurrect bytecode under that package.
src/cellquorum/reports/**/__pycache__/

# Snakemake state and Docker build logs
.snakemake/
docker_build_*.log

# Large single-cell data objects
*.h5ad
*.h5
*.loom
*.mtx
*.rds
*.rda
*.qs

# Downloaded external reference databases (NicheNet networks, SCENIC/cisTarget
# rankings + motif tables, etc.) — populated locally per install, never tracked.
# Some payloads (*.feather, *.tbl, *.txt, *.pre_soupx) fall outside the data-object
# patterns above, so ignore the whole directory to keep 800MB+ out of the repo.
resources/

# Local environment files
.env
.envrc

docs/superpowers/
.superpowers/

# Claude Code worktrees
.claude/worktrees/
.worktrees/
.claude/

# Study-specific run scripts and configs (le_global lymphedema project)
scripts/le_*.py
configs/le_global_granular.yaml
