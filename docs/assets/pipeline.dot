digraph cellquorum_pipeline {
    // Generated from the stage registry by docs/assets/gen_pipeline_diagram.py.
    // Do not edit by hand — regenerate when the stage set changes.
    graph [rankdir=LR, fontname="Helvetica", bgcolor="#ffffff", nodesep=0.40, ranksep=0.85, splines=true];
    node [shape=box, style="rounded,filled", fillcolor="#ffffff", fontname="Helvetica", fontsize=11];

    // Source + sink (run inputs and the run directory).
    IN [label=<<B>config.yaml</B><BR/>AnnData / 10x matrices>, fillcolor="#0b0b0b", color="#0b0b0b", fontcolor="#ffffff", penwidth=1];
    OUT [label=<<B>Run directory</B><BR/><FONT POINT-SIZE="9">figures · results · objects · provenance</FONT>>, fillcolor="#0b0b0b", color="#0b0b0b", fontcolor="#ffffff", penwidth=1];

    // Phase cards (white fill, phase-coloured border).
    P_preprocessing [label=<<B><FONT POINT-SIZE="15" COLOR="#2a78d6">1 · Preprocessing</FONT></B><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>ambient_correction</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">SoupX</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>qc</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">MAD · Scrublet · scDblFinder · cell-cycle</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>preprocessing</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">PFlog1pPF · rapids-singlecell (GPU)</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>feature_selection</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">Seurat · Seurat v3 · Pearson residuals</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>dimensionality</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">PCA · rapids-singlecell (GPU)</FONT><BR ALIGN="LEFT"/>>, color="#2a78d6", fillcolor="#ffffff", penwidth=1.9, margin="0.20,0.13"];
    P_integration [label=<<B><FONT POINT-SIZE="15" COLOR="#eb6834">2 · Integration and clustering</FONT></B><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>integration</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">Harmony · scVI · scANVI</FONT><BR ALIGN="LEFT"/><FONT COLOR="#8a8880">integration_gate<FONT POINT-SIZE="9.5">&#160;&#160;· planned</FONT></FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>clustering</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">Leiden · rapids-singlecell (GPU)</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>annotation</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">marker-vote · CellTypist · passthrough</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>subclustering</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">recursive Leiden · sc-SHC</FONT><BR ALIGN="LEFT"/>>, color="#eb6834", fillcolor="#ffffff", penwidth=1.9, margin="0.20,0.13"];
    P_annotation [label=<<B><FONT POINT-SIZE="15" COLOR="#1baf7a">3 · Annotation and identity</FONT></B><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>adjudication</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">label reconciliation</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>reference_mapping</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">scArches</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>annotation_consensus</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">cross-method consensus</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>annotation_diagnostics</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">scDiagnostics</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>population_identity</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">evidence-ranked identity</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>integration_benchmark</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">scIB metrics</FONT><BR ALIGN="LEFT"/>>, color="#1baf7a", fillcolor="#ffffff", penwidth=1.9, margin="0.20,0.13"];
    P_embeddings [label=<<B><FONT POINT-SIZE="15" COLOR="#eda100">4 · State and embeddings</FONT></B><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>state_scoring</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">score_genes · AUCell</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>discovery</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">consensus NMF</FONT><BR ALIGN="LEFT"/><FONT COLOR="#8a8880">composition<FONT POINT-SIZE="9.5">&#160;&#160;· planned</FONT></FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>embeddings</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">UMAP · PHATE · PAGA · categorical · MAGIC overlay</FONT><BR ALIGN="LEFT"/>>, color="#eda100", fillcolor="#ffffff", penwidth=1.9, margin="0.20,0.13"];
    P_differential [label=<<B><FONT POINT-SIZE="15" COLOR="#e87ba4">5 · Differential analysis</FONT></B><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>differential_expression</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">pseudobulk edgeR</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>differential_abundance</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">propeller · Milo · scCODA · arcsin-sqrt t-test</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>enrichment</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">GSEA · ORA · GSVA · decoupler activity</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>enrichment_viz</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">GSEA · ORA · GSVA plots</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>de_viz</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">volcano</FONT><BR ALIGN="LEFT"/>>, color="#e87ba4", fillcolor="#ffffff", penwidth=1.9, margin="0.20,0.13"];
    P_regulation [label=<<B><FONT POINT-SIZE="15" COLOR="#008300">6 · Gene regulation</FONT></B><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>coexpression</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">hdWGCNA</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>grn</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">pySCENIC</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>perturbation</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">CellOracle</FONT><BR ALIGN="LEFT"/><FONT COLOR="#8a8880">molecular_inference<FONT POINT-SIZE="9.5">&#160;&#160;· planned</FONT></FONT><BR ALIGN="LEFT"/>>, color="#008300", fillcolor="#ffffff", penwidth=1.9, margin="0.20,0.13"];
    P_communication [label=<<B><FONT POINT-SIZE="15" COLOR="#4a3aa7">7 · Communication and trajectory</FONT></B><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>trajectory</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">scVelo · CellRank · DPT · Palantir · CytoTRACE</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>trajectory_viz</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">pseudotime · fate · drivers · gene trends</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>cell_cell_communication</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">LIANA · Tensor-cell2cell · MultiNicheNet · NicheNet</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>multicellular_programs</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">DIALOGUE</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>ccc_network</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">topology · Ollivier-Ricci</FONT><BR ALIGN="LEFT"/><FONT COLOR="#0b0b0b"><B>ccc_viz</B></FONT>&#160;&#160;<FONT POINT-SIZE="9.5" COLOR="#52514e">dotplot · chord · Sankey · curvature</FONT><BR ALIGN="LEFT"/>>, color="#4a3aa7", fillcolor="#ffffff", penwidth=1.9, margin="0.20,0.13"];

    // Shared backbone (heavier spine).
    IN -> P_preprocessing -> P_integration -> P_annotation [color="#5f5e5b", penwidth=2.0, arrowsize=0.9];

    // Fan-out: the annotated object feeds each analysis family.
    P_annotation -> P_embeddings [color="#9a988f", penwidth=1.5, arrowsize=0.8];
    P_annotation -> P_differential [color="#9a988f", penwidth=1.5, arrowsize=0.8];
    P_annotation -> P_regulation [color="#9a988f", penwidth=1.5, arrowsize=0.8];
    P_annotation -> P_communication [color="#9a988f", penwidth=1.5, arrowsize=0.8];

    // Fan-in: every family converges on the run directory.
    P_embeddings -> OUT [color="#9a988f", penwidth=1.5, arrowsize=0.8];
    P_differential -> OUT [color="#9a988f", penwidth=1.5, arrowsize=0.8];
    P_regulation -> OUT [color="#9a988f", penwidth=1.5, arrowsize=0.8];
    P_communication -> OUT [color="#9a988f", penwidth=1.5, arrowsize=0.8];
}
